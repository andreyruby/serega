# Plugins add these modules when they are loaded, thus a type checker does
# not see them on serializers and configs.
class Serega
  module SeregaPlugins
    module ActiverecordPreloads
    end

    module ContextMetadata
      module ConfigInstanceMethods
        def context_metadata: () -> ContextMetadataConfig
      end

      class ContextMetadataConfig
        def initialize: (Hash[Symbol, untyped] opts, Array[Symbol] serialize_keys) -> void

        def key: () -> Symbol?
        def key=: (Symbol? new_key) -> Symbol?
      end
    end

    module Metadata
      module ClassMethods
        def meta_attribute: (*Symbol | String path, **untyped opts) ?{ (untyped objects, context context) -> untyped } -> void
      end
    end

    module Root
      type key = Symbol | String | nil

      module ClassMethods
        def root: (?key root, ?one: key, ?many: key) -> void
      end

      class RootConfig
        def initialize: (Hash[Symbol, untyped] opts) -> void

        def one: () -> key
        def one=: (key value) -> key
        def many: () -> key
        def many=: (key value) -> key
      end

      module ConfigInstanceMethods
        def root: () -> RootConfig
        def root=: ({ one: key, many: key } value) -> void
      end
    end
  end
end
