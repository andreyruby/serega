# frozen_string_literal: true

source "https://rubygems.org"

gem "sqlite3", "~> 2.7", platforms: [:ruby]
gem "activerecord", "~> 8.1"

gem "rake", "~> 13.0"
gem "standard", "~> 1.12", ">= 1.12.1", require: false
gem "rspec", "~> 3.11", require: false
gem "simplecov", "~> 0.22", require: false
gem "rubocop-rake", "~> 0.6", require: false
gem "rubocop-rspec", "~> 3.2", require: false
gem "rubocop-thread_safety", "~> 0.8", require: false
gem "rubocop-packaging", "~> 0.6", require: false
gem "rubocop-md", "~> 2.0", require: false
gem "mdl", "~> 0.13", require: false # Markdown linter
gem "rdoc", "~> 8.1", require: false # Generates and checks API documentation coverage
gem "rbs", "~> 4.0", require: false # Validates the type signatures in sig/
gem "steep", "~> 2.1", require: false # Checks lib/ against the type signatures
gem "rubocop-on-rbs", "~> 2.2", require: false # Lints the type signatures in sig/

gemspec name: "serega", path: "../"
