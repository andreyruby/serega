# frozen_string_literal: true

# Gems of the benchmarks: benchmarks/*.rb and `rake benchmarks:check`

source "https://rubygems.org"

gem "activerecord", "8.1.4"
gem "sqlite3", "2.10.1"

gem "benchmark-ips", "2.15.1"

# The gems serega is compared with
gem "active_model_serializers", "0.10.16"
gem "alba", "4.0.1"
gem "blueprinter", "1.3.0"
gem "oj", "3.17.7"
gem "oj_serializers", "3.0.2"
gem "panko_serializer", "0.8.5"

gemspec name: "serega", path: "../"
